---
import Shell from "../layouts/Shell.astro";
import { splitGuide } from "../lib/guide.mjs";
import source from "../content/rozliczanie-godzin.html?raw";
// Moduł 5 przewodnika (build_modul5.py). Strona celowo bez linków w menu,
// na pulpicie i w przewodniku; poza wyszukiwarkami.
const guide = splitGuide(source);
---

<Shell
  title="Rozliczanie godzin"
  section="Przewodnik dla nauczyciela"
  plain
  noindex
>
  <style is:inline set:html={guide.css}></style>
  <style is:inline>
    /* Odstępy daje już <main> serwisu. */
    .guide {
      padding-inline: 0;
    }
    .guide .hero {
      padding-top: 0;
    }
    .guide .eyebrow {
      margin: 0;
    }
    .guide .hero > *,
    .guide .short li > span {
      min-width: 0;
      overflow-wrap: anywhere;
    }
  </style>
  <div class="guide" set:html={guide.markup} />
  {guide.scripts.map((js) => <script is:inline set:html={js} />)}
</Shell>
