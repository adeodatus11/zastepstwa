---
import "@fontsource/source-sans-3/latin-ext-400.css";
import "@fontsource/source-sans-3/latin-ext-600.css";
import "@fontsource/source-sans-3/latin-ext-700.css";
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/source-sans-3/latin-700.css";
import "../styles/site.css";
import { getImage, Image } from "astro:assets";
import tvLogo from "../assets/logo/logo-komputer-biale.png";
import logoDesktop from "../assets/logo/logo-komputer.png";
import logoPhone from "../assets/logo/logo-telefon.png";
import fs from "node:fs";
const publication = JSON.parse(
  fs.readFileSync("public/data/manifest.json", "utf8"),
);
const publicationLabel = new Date(publication.generatedAt).toLocaleString(
  "pl-PL",
  { timeZone: "Europe/Warsaw" },
);
const {
  title,
  section = "Pulpit",
  tv = false,
  // Strona z własnym nagłówkiem (przewodnik): bez tytułu i stanu danych.
  plain = false,
} = Astro.props;
// Logotypy wg CZYTAJ.txt: komputer 64 px wysokości, telefon 44 px.
const desktopLogo = await getImage({
  src: logoDesktop,
  widths: [552, 1104],
  format: "webp",
});
const phoneLogo = await getImage({
  src: logoPhone,
  widths: [242, 484],
  format: "webp",
});
const guide = "/przewodnik.html";
const menu = [
  ["Pulpit", "/index.html"],
  ["Plan", "/plan.html"],
  ["Aktualności", "/aktualnosci.html"],
  ["Dyżury", "/dyzury-nadzoru.html"],
  ["Kalendarz", "/calendar-2026-2027.html"],
  ["Linki", "/materialy.html"],
  ["Przewodnik dla nauczyciela", guide],
  ["Poczta / Outlook ↗", "https://outlook.office365.com/mail/"],
  [
    "Dokumenty / SharePoint ↗",
    "https://zespolszkolzawodowychnr5.sharepoint.com/sites/rokszkolny20262027/Shared%20Documents/Forms/AllItems.aspx",
  ],
];
---

<!doctype html>
<html lang="pl">
  <head
    ><meta charset="UTF-8" /><meta
      name="app-version"
      content={publication.appVersion}
    /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta
      name="description"
      content="Plan lekcji, zastępstwa, dyżury i kalendarz ZSZ5 we Wrocławiu."
    /><link rel="icon" href="/favicon.png" sizes="32x32" /><link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    /><title>
      {title} — Szkoła Mistrzów
    </title></head
  >
  <body class:list={{ "tv-mode": tv }}
    ><a class="skip" href="#tresc">Przejdź do treści</a>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="brand"
          href="/index.html"
          aria-label="Szkoła Mistrzów — pulpit"
          >{
            tv ? (
              <Image
                src={tvLogo}
                alt="ZSZ5 we Wrocławiu — Szkoła Mistrzów, Plan lekcji"
                width={1120}
                widths={[560, 1120]}
                sizes="560px"
                loading="eager"
                fetchpriority="high"
                format="webp"
              />
            ) : (
              <picture>
                <>
                  <source
                    media="(max-width: 767px)"
                    srcset={phoneLogo.srcSet.attribute}
                    sizes="242px"
                    type="image/webp"
                  />
                  <img
                    src={desktopLogo.src}
                    srcset={desktopLogo.srcSet.attribute}
                    sizes="552px"
                    width="552"
                    height="64"
                    alt="ZSZ5 we Wrocławiu — Szkoła Mistrzów, Strefa Nauczyciela"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                </>
              </picture>
            )
          }</a
        >{
          tv && (
            <img
              class="tv-qr"
              src="/qr-plan.svg"
              width="190"
              height="190"
              alt="Kod QR: plan.szkolamistrzow.info"
            />
          )
        }<a
          class="header-guide"
          href={guide}
          aria-current={section === "Przewodnik dla nauczyciela"
            ? "page"
            : undefined}>Przewodnik dla nauczyciela</a
        ><button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="navigation">Menu</button
        ><nav id="navigation" aria-label="Główna nawigacja">
          {
            menu.map(([name, href]) => (
              <a
                href={href}
                target={href.startsWith("https:") ? "_blank" : undefined}
                rel={href.startsWith("https:") ? "noopener" : undefined}
                aria-current={section === name ? "page" : undefined}
                class={href === guide ? "nav-guide" : undefined}
              >
                {name}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="tresc" tabindex="-1">
      {
        section === "Pulpit" && (
          <h1 class="visually-hidden">Pulpit nauczyciela</h1>
        )
      }
      {
        section !== "Pulpit" && !plain && (
          <div class="page-heading">
            {section !== "Pulpit" && (
              <a class="back" href="/index.html">
                ← Pulpit nauczyciela
              </a>
            )}
            <p class="eyebrow">ZSZ5 · Wrocław</p>
            <>
              <h1>{title}</h1>
              <slot name="intro" />
            </>
          </div>
        )
      }{
        !plain && (
          <div id="data-status" class="status" role="status" aria-live="polite">
            Dane opublikowane {publicationLabel}
          </div>
        )
      }<slot />
    </main>
    {
      tv && (
        <footer class="tv-footer">
          <div class="tv-footer-slides">
            <div class="tv-footer-slide centered active">
              <div class="tv-footer-body">
                <p class="tv-footer-lead">
                  Plan lekcji dostępny także na stronie:
                </p>
                <p class="tv-footer-url">plan.szkolamistrzow.info</p>
              </div>
            </div>
            <div class="tv-footer-slide">
              <div class="tv-footer-body">
                <p class="tv-footer-title">
                  Gdzie odbywa się wychowanie fizyczne?
                </p>
                <ul class="tv-footer-list">
                  <li>
                    <b>Siłownia / ping-pong</b> – piwnica, wejście środkową
                    klatką schodową
                  </li>
                  <li>
                    <b>Sala 8</b> – sala z lustrami, parter (obok portierni)
                  </li>
                  <li>
                    <b>Sala 39</b> – III piętro
                  </li>
                </ul>
                <p class="tv-footer-text">
                  Część zajęć odbywa się w obiektach zewnętrznych – zgodnie z
                  grafikiem przekazywanym przez nauczycieli WF.
                </p>
              </div>
            </div>
            <div class="tv-footer-slide">
              <div class="tv-footer-body">
                <p class="tv-footer-title">Nie możesz znaleźć swojej sali?</p>
                <p class="tv-footer-text">
                  Zeskanuj kod – prosta nawigacja po budynkach ZSZ5:
                </p>
                <p class="tv-footer-url small">nawigacja.szkolamistrzow.info</p>
              </div>
              <img
                class="tv-qr"
                src="/qr-nawigacja.svg"
                width="190"
                height="190"
                alt="Kod QR: nawigacja.szkolamistrzow.info"
              />
            </div>
          </div>
        </footer>
      )
    }
    <footer class="site-footer">
      <span>Szkoła Mistrzów · ZSZ5 we Wrocławiu</span><div>
        <a href="/tv.html">Ekran TV</a><a
          href="https://www.zsz5.edupage.org"
          target="_blank"
          rel="noopener">Strona szkoły ↗</a
        >
      </div>
    </footer>
    <script>
      const appVersion = document.querySelector<HTMLMetaElement>(
        'meta[name="app-version"]',
      )?.content;
      async function checkAppVersion() {
        if (document.hidden) return;
        try {
          const response = await fetch("/data/manifest.json", {
            cache: "no-store",
          });
          if (!response.ok) return;
          const next = await response.json();
          if (
            typeof next.appVersion !== "string" ||
            next.appVersion === appVersion
          )
            return;
          const url = new URL(location.href);
          if (url.searchParams.get("_v") === next.appVersion) return;
          url.searchParams.set("_v", next.appVersion);
          location.replace(url.href);
        } catch {
          /* Keep the current page available during a connection failure. */
        }
      }
      setInterval(checkAppVersion, 120000);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) void checkAppVersion();
      });

      document
        .querySelector(".menu-toggle")
        ?.addEventListener("click", (event) => {
          const b = event.currentTarget as HTMLButtonElement;
          b.setAttribute(
            "aria-expanded",
            String(b.getAttribute("aria-expanded") !== "true"),
          );
        });
    </script>
  </body>
</html>
