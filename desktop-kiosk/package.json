{
  "name": "szkola-mistrzow-kiosk",
  "version": "1.2.0",
  "private": true,
  "description": "Pulpit nauczyciela — kiosk szkolny",
  "author": "Szkoła Mistrzów",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs snapshot.test.cjs displays.test.cjs",
    "dist:win": "electron-builder --win zip --x64",
    "installer:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "info.szkolamistrzow.nauczyciel.kiosk",
    "productName": "Pulpit nauczyciela",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "policy.cjs",
      "offline.html",
      "snapshot.cjs",
      "schema.mjs",
      "displays.cjs",
      "settings.html",
      "settings.css",
      "settings.js",
      "settings-preload.cjs"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraFiles": [
      {
        "from": "README.md",
        "to": "INSTRUKCJA.txt"
      }
    ]
  }
}
